[Unit]
Description=API Flask de prediccion de riego
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aru/AWS-ML-Irrigation-System
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/aru/AWS-ML-Irrigation-System/venv/bin/python /home/aru/AWS-ML-Irrigation-System/app.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
